[Unit]
Description=ushr agent (podman/docker runner driver)
After=ushr-controller.service

[Service]
# User units get a minimal PATH; the driver execs "docker"/"podman" by name
# (autodetected), so include the dirs a rootless runtime may install into.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/ushr-agent -config %h/.config/ushr/agent.yaml
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
